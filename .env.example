# =================================================================
# Configurações do Banco de Dados (Prisma + SQLite)
# =================================================================
DATABASE_URL="file:./dev.db"

# =================================================================
# Provedor de IA: Google Gemini (@google/genai)
# Obtenha sua chave gratuita em: https://aistudio.google.com/apikey
# O código aceita GEMINI_API_KEY, API_KEY ou GOOGLE_API_KEY
# =================================================================
GEMINI_API_KEY="sua_chave_do_google_ai_studio_aqui"
GEMINI_MODEL="gemini-3.1-flash-lite"

# =================================================================
# Configurações do Negócio & Personalidade do Bot
# =================================================================
BOT_NAME="Sophia"
BARBERSHOP_NAME="Barbearia Estilo & Navalha"
BARBERSHOP_OPEN_HOUR=9
BARBERSHOP_CLOSE_HOUR=18
